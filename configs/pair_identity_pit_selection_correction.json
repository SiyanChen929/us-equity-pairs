{
  "protocol": {
    "name": "pair_identity_point_in_time_selection_correction",
    "version": 1,
    "as_of": "2026-08-26",
    "additive_only": true,
    "overwrite_v6": false,
    "purpose": "Point-in-time universe replay, first-knowable identity entry, synchronized reranking bootstrap, and family-wise pair winner correction."
  },
  "point_in_time_data": {
